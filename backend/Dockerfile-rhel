# Build executable bundle for RHEL 9.x
# Compatible with glibc 2.34+ (RHEL 9.8, 9.x)
FROM redhat/ubi9:latest

# Force cache bust - timestamp
ENV CACHE_BUST="2026-09-01-20-47-final"

WORKDIR /root/config-assessment-tool

# Install Python 3.12 and build dependencies
RUN dnf install -y \
    python3.12 \
    python3.12-devel \
    gcc \
    make \
    git \
    zip \
    tar \
    gzip \
    && dnf clean all

# Bootstrap pip using ensurepip (built-in to Python 3.12)
RUN python3.12 -m ensurepip --upgrade && \
    ln -sf /usr/bin/python3.12 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.12 /usr/bin/python && \
    python3 -m pip --version

# Copy repository content
COPY . .

# Install Python dependencies and build the bundle
RUN make install && \
    make exec-bundle

# Create tarball from the bundle
WORKDIR /root

RUN OS_ID=$(grep '^ID=' /etc/os-release | cut -d'=' -f2 | tr -d '"' | tr '[:upper:]' '[:lower:]') && \
    ARCH=$(uname -m) && \
    echo "Detected OS: $OS_ID, Architecture: $ARCH" && \
    tar -zcvf /root/config-assessment-tool/dist/config-assessment-tool-linux-$(cat config-assessment-tool/VERSION)-${OS_ID}-${ARCH}.tgz -C /root/config-assessment-tool/dist/appdynamics . && \
    ls -altrh /root/config-assessment-tool/dist/

# Default command to list the bundle
CMD ["find", "/root/config-assessment-tool/dist/", "-name", "*.tgz"]
