# Build executable bundle for RHEL 9.x
# Compatible with glibc 2.34+ (RHEL 9.8, 9.x)
# Cache-bust: 2026-09-01-v2
FROM redhat/ubi9:latest

WORKDIR /root/config-assessment-tool

# Install Python 3.12 and build dependencies
RUN dnf install -y \
    python3.12 \
    python3.12-devel \
    curl \
    gcc \
    make \
    git \
    zip \
    tar \
    gzip \
    && dnf clean all

# Bootstrap pip using get-pip.py script
RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12 && \
    ln -sf /usr/bin/python3.12 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.12 /usr/bin/python && \
    python3 -m pip --version

# Copy repository content
COPY . .

# Install Python dependencies and build the bundle
RUN make install && \
    make exec-bundle

# Default command to list the bundle
CMD ["find", "/root/config-assessment-tool/dist/", "-name", "*.tgz"]
